{
  "name": "order-report-app",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first Android order, shipment, inventory and return tracking app.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "predev": "npm run build:web",
    "build:web": "node scripts/build-web-assets.js",
    "pretest": "npm run build:web",
    "test": "node --test test/*.test.js",
    "test:legacy": "ORDER_REPORT_LEGACY_TEST=1 node --test test/app-sync.test.js",
    "android:assets": "node scripts/sync-android-assets.js",
    "restore:backup": "node scripts/restore-sqlite-backup.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "esbuild": "0.28.2"
  }
}
